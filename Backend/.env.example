PORT=5000

# Database (XAMPP default: user root, empty password)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=university_api_db

# Predefined admin API key (sent in the x-api-key header for /api/admin/*)
ADMIN_API_KEY=admin_university_2026_secret

# Allowed frontend origins, comma separated, or * for any
CORS_ORIGIN=*
